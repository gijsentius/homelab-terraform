#!/usr/bin/env bash
# Rendered by nfs_server.tf and run as root on the NFS server VM over SSH.
# Safe to re-run: it never formats a disk that already has a filesystem.
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

# First boot: let cloud-init finish (apt sources, user, network) first.
cloud-init status --wait >/dev/null || true

# Login keys for 'debian', managed here rather than only through cloud-init,
# which applies them on first boot only. Replaces the file, so a key removed
# from nfs_server.ssh_public_keys is revoked on the next apply. Terraform's
# own key is always first; without it the provisioner can't log in.
install -d -m 700 -o debian -g debian /home/debian/.ssh
cat > /home/debian/.ssh/authorized_keys.new <<'KEYS'
${ssh_authorized_keys}
KEYS
chown debian:debian /home/debian/.ssh/authorized_keys.new
chmod 600 /home/debian/.ssh/authorized_keys.new
mv /home/debian/.ssh/authorized_keys.new /home/debian/.ssh/authorized_keys

apt-get update -q
apt-get install -y -q nfs-kernel-server xfsprogs

# Data disk: format only when blank, then mount by label at /srv/nfs.
disk="${data_disk}"
for _ in $(seq 30); do [[ -e "$disk" ]] && break; sleep 2; done
if ! blkid "$disk" >/dev/null 2>&1; then
  mkfs.xfs -L nfs-data "$disk"
fi
mkdir -p /srv/nfs
if ! grep -q '^LABEL=nfs-data ' /etc/fstab; then
  echo 'LABEL=nfs-data /srv/nfs xfs defaults,nofail 0 2' >> /etc/fstab
fi
systemctl daemon-reload
mountpoint -q /srv/nfs || mount /srv/nfs
# Pick up a data disk that was enlarged in Proxmox.
xfs_growfs /srv/nfs >/dev/null

# Shared media library (StorageClass nfs-media in homelab-apps), owned by
# the uid:gid the media containers run as.
mkdir -p /srv/nfs/media
chown "${media_owner}" /srv/nfs/media

# no_root_squash: csi-driver-nfs creates and removes per-volume directories
# as root. Access is limited to the cluster network instead.
mkdir -p /etc/exports.d
cat > /etc/exports.d/k8s.exports <<EXPORTS
/srv/nfs ${export_cidr}(rw,sync,no_subtree_check,no_root_squash)
EXPORTS

systemctl enable --now nfs-server
exportfs -ra
exportfs -v

# Tailscale, for SSH/admin access from the tailnet. Installed always (cheap,
# and ready if a key is added later); only joins when a key was uploaded
# (the operator's OAuth client secret) and the node isn't logged in yet, so
# re-runs never re-register.
auth_key_file=/tmp/tailscale-auth-key
if ! command -v tailscale >/dev/null; then
  apt-get install -y -q curl ca-certificates
  . /etc/os-release
  curl -fsSL "https://pkgs.tailscale.com/stable/debian/$VERSION_CODENAME.noarmor.gpg" \
    -o /usr/share/keyrings/tailscale-archive-keyring.gpg
  curl -fsSL "https://pkgs.tailscale.com/stable/debian/$VERSION_CODENAME.tailscale-keyring.list" \
    -o /etc/apt/sources.list.d/tailscale.list
  apt-get update -q
  apt-get install -y -q tailscale
fi
systemctl enable --now tailscaled
if [[ -s "$auth_key_file" ]] && ! tailscale status >/dev/null 2>&1; then
  tailscale up --auth-key="file:$auth_key_file" \
    --hostname="${tailscale_hostname}" --advertise-tags="${tailscale_tags}"
fi
rm -f "$auth_key_file"
tailscale status --self --peers=false || true
