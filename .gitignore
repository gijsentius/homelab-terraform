# Terraform state — contains secrets and infrastructure state, never commit
*.tfstate
*.tfstate.*
*.tfstate.backup

# Variable files — contain your actual secrets and IP addresses
*.tfvars
!*.tfvars.example

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# ---- Talos ----

# Cluster credentials — generated by the talos and local providers on every apply.
# Cluster secrets themselves live only in terraform.tfstate, never a file here.
kubeconfig
*.kubeconfig
talosconfig

# Generated ArgoCD manifests — rendered from templates/, contain secrets or repo URLs
argocd-root-app.yaml
argocd-repo-secret.yaml

# Mono repo, cloned fresh on every apply by terraform_data.homelab_apps_checkout
.homelab-apps-checkout/
